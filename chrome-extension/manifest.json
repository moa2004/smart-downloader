{
  "manifest_version": 3,
  "name": "Smart Downloader",
  "version": "1.0.0",
  "description": "Capture playable media links from the current tab and send them to Smart Downloader.",
  "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>", "http://localhost:5177/*", "https://smart-downloader.vercel.app/*", "https://*.vercel.app/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
